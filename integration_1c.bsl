Функция ОтправитьКодНаРевью(ТекстКода) Экспорт
    
    // 1. Формируем структуру для JSON
    ЗапросСтруктура = Новый Структура;
    ЗапросСтруктура.Вставить("model", "deepseek-coder:1.3b");
    ЗапросСтруктура.Вставить("prompt", "Ты эксперт по 1С. Проанализируй этот код и найди все проблемы:" + Символы.ПС + ТекстКода);
    ЗапросСтруктура.Вставить("stream", Ложь);
    
    // 2. Превращаем структуру в строку JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ЗапросСтруктура);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    // 3. Подключаемся к Ollama (порт 11434)
    // Внимание: если 1С на Windows, а Docker в WSL, localhost может не работать.
    // Тогда укажи IP-адрес WSL (см. примечание ниже).
    Соединение = Новый HTTPСоединение("localhost", 11434, , , , 120); // 120 секунд таймаут
    
    // 4. Создаём POST-запрос
    ЗапросHTTP = Новый HTTPЗапрос("/api/generate");
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
    
    // 5. Отправляем и получаем ответ
    Попытка
        ОтветHTTP = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
    Исключение
        Возврат "Ошибка подключения: " + ОписаниеОшибки();
    КонецПопытки;
    
    // 6. Проверяем код ответа и разбираем JSON
    Если ОтветHTTP.КодСостояния = 200 Тогда
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8"));
        РезультатJSON = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        // В ответе Ollama поле "response" содержит текст ревью
        Если РезультатJSON.Свойство("response") Тогда
            Возврат РезультатJSON.response;
        Иначе
            Возврат "В ответе нет поля 'response'. Ответ: " + ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
        КонецЕсли;
    Иначе
        Возврат "Ошибка Ollama. Код: " + ОтветHTTP.КодСостояния + ". Тело: " + ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
    КонецЕсли;
    
КонецФункции
